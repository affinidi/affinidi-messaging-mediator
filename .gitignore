**/.DS_Store
**/.vscode
/target
# Alternate CARGO_TARGET_DIR used when running clippy alongside a build so the
# two don't thrash one cache. A build artefact dir — never committed.
/target-clippy
/target-*/
# cargo-fuzz build output and corpora (fuzz/ is its own workspace).
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/
environments.json
# Cargo.lock is COMMITTED. This workspace ships binaries operators build from
# source — the mediator and the mediator-setup wizard — and without a lockfile
# `--locked` has nothing to honour, so every clone resolves from scratch and
# inherits whatever upstream published that morning. That is how an
# `aws-smithy-types` MINOR release broke every wizard build in September 2026.
# The libraries published from here are unaffected: cargo ignores a dependency's
# lockfile, so this constrains only builds of this repository.
**/environments.json*

# mediator-setup wizard generated artifacts (may land in any directory).
# admin-monitor.json holds the admin Ed25519 private key; did.jsonl and
# did-web.json are the minted identity. .dockerignore mirrors these.
**/conf/secrets.json
**/conf/secrets-admin.json
**/conf/admin-monitor.json
**/conf/keys/
**/did.jsonl
**/did-web.json
# Exception: the docker-compose.test.yml stack's fixed TEST-ONLY identity is
# committed on purpose (see the header of docker-compose.test.yml). NEVER
# reuse it.
!docker/test/conf/secrets.json
!docker/test/conf/admin-monitor.json
**/bootstrap-request.json
**/bootstrap-request-vp.json
**/*.armor

# Superego
.superego/

# Local agent state (Claude Code, etc.)
.claude/

# Secrets and credentials
.env
.env.*

# TSP interop harness build artifacts (standalone workspace)
interop/target/

# Python bytecode from scripts/
__pycache__/
